# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000
FALLBACK_PORT=8080

# AI Provider Keys (Optional: Leave empty to run zero-drain offline high-precision engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Retrieval Hyperparameters
RRF_K=60
RRF_CANDIDATE_COUNT=30
DEFAULT_TOP_K=5
BM25_K1=1.5
BM25_B=0.75

# Redis Semantic Caching (Optional: Uses in-memory vector similarity cache by default)
REDIS_URL=
ENABLE_REDIS=false
CACHE_SIMILARITY_THRESHOLD=0.95

# PostgreSQL pgvector (Optional: Uses in-memory vector store by default)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/aidb
ENABLE_PGVECTOR=false
